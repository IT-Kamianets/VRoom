rules_version = '2';

// Data layout of 3d-unity-firebase: profiles and progress belong to their player,
// scenes are readable by any signed-in player and writable by their owner.
//
// WARNING: the Firebase project vroom-8ef42 is shared with other apps (the `interiors` rules of VRoom's
// first version, and Assetra), and the console keeps ONE published rule set for the whole project.
// Never publish this file as it is: that would delete their rules. Merge the blocks below into the
// published set (Firebase console -> Firestore Database -> Rules) and keep everything that is already there.
// The game needs at least the `users/{uid}/progress/{key}` block (the project list is saved there).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{key} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /scenes/{sceneId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
